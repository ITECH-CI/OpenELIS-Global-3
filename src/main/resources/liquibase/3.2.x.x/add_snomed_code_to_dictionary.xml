<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Code SNOMED CT de référence pour les entrées de dictionnaire (organismes,
         antibiotiques, etc.). Alimente le coding SNOMED des ressources FHIR quand
         renseigné. Colonne optionnelle, symétrique de LOINC_CODE. -->
    <changeSet id="add_snomed_code_to_dictionary" author="itechciv">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="dictionary" columnName="snomed_code" schemaName="clinlims"/>
            </not>
        </preConditions>
        <addColumn tableName="dictionary" schemaName="clinlims">
            <column name="snomed_code" type="VARCHAR(20)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
