<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
      Module d'échange unifié — incrément 5 (config admin des flux de sync).

      Réglages du serveur consolidé stockés en SiteInformation (clé/valeur admin,
      éditables sans redémarrage via un écran dédié). Le mot de passe est
      `encrypted=true` : chiffré au repos par jasypt (SiteInformationServiceImpl),
      masqué à l'affichage. Les clés SiteInformation.name font AU PLUS 32 caractères
      (contrainte de colonne). Domaine dédié `consolidatedSync`.

      Idempotent : preConditions sqlCheck (n'insère la ligne que si absente).
      Les tasks (DataSyncTask/DataPullTask/DataPushTask) lisent ces valeurs à chaque
      tick via SyncConfigService ; l'intervalle @Scheduled reste figé au démarrage.
    -->

    <property name="now" value="now()" dbms="postgresql"/>

    <changeSet id="add_consolidated_sync_domain" author="itechciv">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM clinlims.site_information_domain WHERE name =
                'consolidatedSync'</sqlCheck>
        </preConditions>
        <insert schemaName="clinlims" tableName="site_information_domain">
            <column name="id" valueSequenceNext="site_information_domain_seq"/>
            <column name="name" value="consolidatedSync"/>
            <column name="description" value="Configuration de la synchronisation vers le serveur consolidé"/>
        </insert>
    </changeSet>

    <!-- Flags d'activation par flux (booléens). -->
    <changeSet id="add_consolidated_sync_enabled" author="itechciv">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM clinlims.site_information WHERE name =
                'consolidatedSyncEnabled'</sqlCheck>
        </preConditions>
        <insert schemaName="clinlims" tableName="site_information">
            <column name="id" valueSequenceNext="site_information_seq"/>
            <column name="name" value="consolidatedSyncEnabled"/>
            <column name="lastupdated" valueComputed="${now}"/>
            <column name="description" value="Activer la remontée sortante (analyses/résultats) vers le serveur consolidé"/>
            <column name="encrypted" value="false"/>
            <column name="domain_id"
                valueComputed="(SELECT id FROM site_information_domain WHERE name = 'consolidatedSync')"/>
            <column name="value_type" value="boolean"/>
            <!-- Vide au seed (pas "false") : tant que l'admin n'a rien saisi,
                 SyncConfigService retombe sur la property (rétro-compat). Une fois
                 sauvegardé via l'écran, la valeur DB fait autorité. -->
            <column name="value" value=""/>
            <column name="group" value="0"/>
        </insert>
    </changeSet>

    <changeSet id="add_consolidated_pull_enabled" author="itechciv">
