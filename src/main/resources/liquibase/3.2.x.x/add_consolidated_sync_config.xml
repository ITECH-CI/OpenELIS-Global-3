            <column name="lastupdated" valueComputed="${now}"/>
            <column name="description" value="Activer le push des statuts/résultats vers le serveur consolidé"/>
            <column name="encrypted" value="false"/>
            <column name="domain_id"
                valueComputed="(SELECT id FROM site_information_domain WHERE name = 'consolidatedSync')"/>
            <column name="value_type" value="boolean"/>
            <column name="value" value=""/>
            <column name="group" value="0"/>
        </insert>
    </changeSet>

