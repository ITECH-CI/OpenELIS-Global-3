<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class
        name="org.openelisglobal.dataexchange.order.valueholder.ElectronicOrder"
        table="ELECTRONIC_ORDER" optimistic-lock="version"
        dynamic-update="true">
        <id name="id"
            type="org.openelisglobal.hibernate.resources.usertype.LIMSStringNumberUserType">
            <column name="ID" precision="10" scale="0" />
            <generator
                class="org.openelisglobal.hibernate.resources.StringSequenceGenerator">
                <param name="sequence_name">electronic_order_seq</param>
            </generator>
        </id>
        <version name="lastupdated" column="LASTUPDATED"
            type="timestamp" access="field" />
        <property name="orderTimestamp" type="java.sql.Timestamp">
            <column name="ORDER_TIMESTAMP" length="7" not-null="true" />
        </property>
        <property name="externalId" type="java.lang.String">
            <column name="EXTERNAL_ID" length="60" not-null="true" />
        </property>
        <many-to-one name="patient"
            class="org.openelisglobal.patient.valueholder.Patient" fetch="select"
            lazy="false">
            <column name="patient_id" precision="10" scale="0" />
        </many-to-one>
        <property name="statusId"
            type="org.openelisglobal.hibernate.resources.usertype.LIMSStringNumberUserType"
            column="status_id" precision="10" not-null="true" />
        <property name="data" type="java.lang.String">
            <column name="data" not-null="true" />
        </property>
        <property name="type">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">org.openelisglobal.dataexchange.order.valueholder.ElectronicOrderType</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="priority" column="ORDER_PRIORITY">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">org.openelisglobal.sample.valueholder.OrderPriority</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <!-- reject_reason_id est numeric en base (comme status_id/organization_id
            ci-dessus), pas varchar : sans LIMSStringNumberUserType, Hibernate envoie
            une chaîne brute -> "column is of type numeric but expression is of type
            character varying" au premier rejet d'une demande électronique. -->
        <property name="rejectReasonId"
            type="org.openelisglobal.hibernate.resources.usertype.LIMSStringNumberUserType">
            <column name="reject_reason_id" precision="10" not-null="false" />
        </property>
        <property name="qaAuthorizer" type="java.lang.String">
            <column name="rejection_author" length="200" not-null="false" />
        </property>
        <property name="rejectComment" type="java.lang.String">
            <column name="reject_comment" length="60" not-null="false" />
        </property>
        <!-- Colonnes d'affichage dénormalisées (module d'échange unifié, incrément
            4a) : remplies à la réception, listent les demandes sans appel FHIR. Génériques.
            Cf. DESIGN_INTEROP_MODULE_CIV.md §6.1. -->
        <property name="requestingFacilityName"
            type="java.lang.String">
            <column name="requesting_facility_name" length="255"
                not-null="false" />
        </property>
        <property name="collectionDate" type="java.sql.Timestamp">
            <column name="collection_date" not-null="false" />
        </property>
        <property name="testName" type="java.lang.String">
            <column name="test_name" length="255" not-null="false" />
        </property>
        <!-- Colonne renseignée hors-Liquibase par l'ancien uploader (cf. DESIGN_INTEROP_MODULE_CIV.md
            §6.1) : souvent la SEULE source fiable du site demandeur en pratique. -->
        <property name="organizationId"
            type="org.openelisglobal.hibernate.resources.usertype.LIMSStringNumberUserType">
            <column name="organization_id" precision="10" not-null="false" />
        </property>
    </class>
</hibernate-mapping>
